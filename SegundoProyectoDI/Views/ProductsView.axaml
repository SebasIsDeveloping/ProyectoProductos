<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:vm="clr-namespace:SegundoProyectoDI.ViewModels"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:DataType="vm:ProductsViewModel"
             x:Class="SegundoProyectoDI.Views.ProductsView">
    
        <Grid >
            <Grid.Background>
                <ImageBrush Stretch="UniformToFill" Source="avares://SegundoProyectoDI/Assets/fondoPelis.jpg"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <dialogHostAvalonia:DialogHost Identifier="EditDialog" CloseOnClickAway="True" Grid.RowSpan="2" ZIndex="1">
                <dialogHostAvalonia:DialogHost.Content/>
            </dialogHostAvalonia:DialogHost>
            
            <dialogHostAvalonia:DialogHost Identifier="DeleteDialog" CloseOnClickAway="True" Grid.RowSpan="2" ZIndex="1">
                <dialogHostAvalonia:DialogHost.Content/>
            </dialogHostAvalonia:DialogHost>
            
            <!-- PRIMERA ROW -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black" Width="900" Margin="0,26,0,0" >
                <TextBlock TextAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,20,0,0">Todas las películas</TextBlock>
                <TextBlock TextAlignment="Center" FontSize="25" TextWrapping="Wrap" Margin="0,20,0,0">Aquí podrás ver las películas que tenemos disponibles</TextBlock>
            </StackPanel>
            
            <!-- SEGUNDA ROW -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"  Background="Black" Height="550" Width="900"  Margin="0,0,0,27">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        
                        <!-- LISTA -->
                        <Border  Margin="40, 70,0,0" CornerRadius="5" Padding="10" BorderBrush="White" BorderThickness="3">   
                            <StackPanel HorizontalAlignment="Center" Height="400" >
                               <ListBox ItemsSource="{Binding ListaLibros}"
                                        Name="ListBoxProductos" Height="400" Background="#FF0B0F12">
                                
                                   <ListBox.ItemTemplate>
                                    <DataTemplate> 
                                      <Border Margin="0" CornerRadius="5" Padding="7" 
                                              Background="#333333" BorderBrush="Gray" BorderThickness="1"
                                              >
                                        <StackPanel Orientation="Horizontal" Spacing="10" Background="#333333">
                                          
                                          <StackPanel Orientation="Vertical" Spacing="2" Width="60"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" >
                                              <!-- <Image Source="{Binding Imagen}" Width="50" Height="55"/> -->
                                              <TextBlock Text="{Binding Categoria}"  TextAlignment="Center" />
                                              <TextBlock Text="{Binding Cantidad}" TextAlignment="Center" />
                                          </StackPanel>

                                          <StackPanel Orientation="Vertical" Spacing="5" Width="350">
                                              <TextBlock Text="{Binding Nombre}" />
                                              <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" />
                                              <TextBlock Text="{Binding Bluray}" />
                                          </StackPanel>
                                            
                                            
                                            <StackPanel Orientation="Vertical" Spacing="5" Width="250">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="Publicación: "/>
                                                    <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Bluray}" />
                                          </StackPanel>

                                           
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </StackPanel>
                        </Border>   
            
                        <!-- BOTONES -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="120" Spacing="50" HorizontalAlignment="Center" Orientation="Vertical" Margin="0,40,0,0">
                                <Button Classes="light" Content="Volver" Command="{Binding GoBackCommand}" CommandParameter="home"
                                        ToolTip.Tip="Button with classes &quot;Light&quot;" />
                                
                                <Button Classes="dark" Content="Eliminar" ToolTip.Tip="Button with classes &quot;Dark&quot;" 
                                        Command="{Binding OpenDeleteDialogCommand}"
                                        CommandParameter="{Binding ElementName=ListBoxProductos, Path=SelectedItem}" />
                                
                                <Button Classes="dark" Content="Editar"  Command="{Binding OpenEditDialogCommand}"
                                        Background="Orange" ToolTip.Tip="Button with classes &quot;dark&quot;" 
                                        CommandParameter="{Binding ElementName=ListBoxProductos, Path=SelectedItem}"/>
                                
                        </StackPanel>    
           
                    </Grid>  
            </StackPanel>    
           
        </Grid>
</UserControl>

















