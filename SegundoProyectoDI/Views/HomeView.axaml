<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SegundoProyectoDI.Views.HomeView">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" Source="avares://SegundoProyectoDI/Assets/fondoPelis.jpg"/>
        </Grid.Background>

        <Border Background="#CC000000" />

        <Border Margin="0" CornerRadius="5" Padding="10" BorderBrush="White" BorderThickness="5">   
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            
            <TextBlock Text="🎬 Bienvenido a CineApp" 
                       FontSize="48" FontWeight="Bold" 
                       Foreground="White" TextAlignment="Center"/>

            <TextBlock Text="Descubre y disfruta todas nuestras películas" 
                       FontSize="24" FontWeight="SemiBold" 
                       Foreground="#FFD3D3D3" TextAlignment="Center"/>
        </StackPanel>
        </Border>
    </Grid>
</UserControl>
