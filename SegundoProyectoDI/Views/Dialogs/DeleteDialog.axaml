<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SegundoProyectoDI.Views.Dialogs"
             xmlns:viewModels="clr-namespace:SegundoProyectoDI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ProductsViewModel"
             x:Class="SegundoProyectoDI.Views.Dialogs.DeleteDialog">
    <StackPanel>
        <TextBlock TextAlignment="Center" FontSize="25" TextWrapping="Wrap" Margin="0,20,0,0">¿Estás seguro de eliminar esta película?</TextBlock>

        <StackPanel VerticalAlignment="Center" Width="120" Spacing="50" HorizontalAlignment="Center" Orientation="Vertical" Margin="0,40,0,0">
            <Button Classes="light" Content="Aceptar" Command="{Binding  DeleteProductCommand}"
                    ToolTip.Tip="Button with classes &quot;Light&quot;" />
            <Button Classes="dark" Content="Eliminar" Command="{Binding CloseDeleteDialogCommand}"
                    ToolTip.Tip="Button with classes &quot;Dark&quot;" />
        </StackPanel>   
    </StackPanel>
</UserControl>
