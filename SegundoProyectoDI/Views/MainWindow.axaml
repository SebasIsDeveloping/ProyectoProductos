<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SegundoProyectoDI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SegundoProyectoDI.Views" CanResize="False"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        mc:Ignorable="d" x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1280"  Width="1280"
        d:DesignHeight="720"  Height="720"
        x:Class="SegundoProyectoDI.Views.MainWindow" 
        Icon="/Assets/avalonia-logo.ico"
        Title="SegundoProyectoDI">
    
        <Design.DataContext>
            <vm:MainWindowViewModel />
        </Design.DataContext>
    
        <views:MainView/>
</Window>
